.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
datasets/

# Production secrets. ".env" above only matches that exact filename, not
# "deploy/.env.prod" - a real secrets file living one directory over from
# .gitignore is exactly the kind of thing that gets committed by accident.
deploy/.env.prod

# Verification workspace generated artifacts (keep scripts/ README)
verification/debug_outputs/
verification/visualizations/
verification/temp/
verification/comparisons/
verification/benchmark_reports/

# Generated images and JSON are scoped to the directories that produce them,
# never matched globally. A blanket *.json here excluded frontend/package.json
# and the tsconfigs from the repository entirely, so a fresh clone could not
# build the frontend at all; *.png did the same to anything in frontend/public.
local_runs/
forensic_runs/
datasets/
benchmarks/
results/
ocr/
test_images/
item_rows_clean.json
*.jsonl
*.pkl

# Export scripts
# scripts/export_codebase.py
# scripts/export_codebase.sh

# Local/runtime artifacts
venv/
working_requirements.txt

.DS_Store
**/.DS_Store

frontend/node_modules
frontend/dist/

# The blanket *.json rule above is aimed at OCR result dumps, but it also
# swallows the frontend's build configuration - which means a fresh clone
# has src/ and no package.json, and the app cannot be installed or built at
# all. Re-include the config files by name.
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig*.json

# Test fixtures are source, not output. The rule above hides them, which does
# not fail loudly - it fails as a test that passes locally and errors on a
# fresh clone with a missing-file traceback.
!tests/fixtures/**/*.json

# Agent workspace. worktrees/ especially: it contains checkouts of this same
# repo, and publishing those would nest the repository inside itself.
# .claude/launch.json is already tracked and stays so - an ignore rule does not
# untrack a file - which is why there is no negation for it here: one inside an
# excluded directory would not work anyway, and reading as though it did is
# worse than its absence.
.claude/
