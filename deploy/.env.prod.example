# Copy to deploy/.env.prod and fill in real values. This file is read by
# BOTH containers (see docker-compose.prod.yml) so it's one place to manage
# secrets, even though each half only uses the variables relevant to it.
# NEVER commit deploy/.env.prod - only this .example file is tracked.

# --- Edge (Caddy) --------------------------------------------------------

# The domain this deploy answers to. Must already resolve to this server's
# IP (see DEPLOY.md) before Caddy can obtain a TLS certificate - it will
# retry, but nothing is reachable over HTTPS until DNS is live.
DOMAIN=pharmagpt.co

# Interim access gate for the whole site, until the app has real per-user
# login. Generate the hash with (do not type a plaintext password anywhere
# in this file or in the Caddyfile):
#   docker run --rm caddy:2-alpine caddy hash-password
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# --- Backend: Azure Document Intelligence --------------------------------

DOCUMENTINTELLIGENCE_ENDPOINT=
DOCUMENTINTELLIGENCE_API_KEY=
AZURE_DI_MODEL_ID=prebuilt-invoice

# --- Backend: Neo4j Aura --------------------------------------------------

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# --- Backend: Cloudflare R2 (invoice image storage) -----------------------

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Backend: misc ---------------------------------------------------------

# Bootstrap tenant. The app has no multi-tenant auth yet, so every invoice
# uploaded through this deploy belongs to this one pharmacy record.
DEFAULT_PHARMACY_ID=default-pharmacy
DEFAULT_PHARMACY_NAME=My Pharmacy
DEFAULT_USER_ID=default-user
DEFAULT_USER_EMAIL=admin@pharmagpt.co

LOG_LEVEL=INFO
