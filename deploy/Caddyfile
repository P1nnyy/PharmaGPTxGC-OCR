# Production edge: terminates TLS for {$DOMAIN}, gates the whole site behind
# a single shared login (the interim access control until the app has real
# per-pharmacy auth), and serves the built SPA and the API from one origin -
# so the frontend calls relative paths like /invoices exactly as it does
# against the Vite dev proxy, and no CORS configuration is needed anywhere.
#
# {$DOMAIN}, {$BASIC_AUTH_USER}, {$BASIC_AUTH_HASH} are read from the
# environment at container start (see deploy/.env.prod.example). The hash is
# generated with `caddy hash-password` - Caddy refuses plaintext passwords in
# its config, so there is nothing here to leak even if this file is read by
# someone who shouldn't have it.

# Anyone who types the www form lands on the canonical apex. This needs its
# own site block, not just a DNS record: Caddy issues a certificate per site
# address it is configured for, so a www A record pointing here with no block
# to match it fails TLS rather than redirecting.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# No basic_auth here, deliberately. HTTP allows one Authorization header,
	# and the application sends `Authorization: Bearer <jwt>` on every API
	# call - which replaces the browser's automatic `Authorization: Basic`.
	# Caddy then saw a Bearer where it wanted Basic, answered 401 with
	# `WWW-Authenticate: Basic`, and the browser popped its native sign-in
	# dialog on every request a signed-in user made. The two schemes cannot
	# share the header, so the outer gate had to go once the app grew a real
	# one of its own.
	#
	# Access is now the application's own: nothing reads or writes pharmacy
	# data without a session, and each account is confined to its own
	# workspace. BASIC_AUTH_USER / BASIC_AUTH_HASH are left in .env.prod,
	# unused, in case this file is ever reused for a deployment with no
	# application-level auth.

	encode gzip

	# Caching. Caddy sends no Cache-Control of its own, and "no header" does
	# not mean "do not cache" - it means the browser applies heuristic
	# freshness, roughly a tenth of the age of the file. index.html is weeks
	# old, so browsers were treating it as fresh for days: a deploy went out,
	# the server was correct, and the page kept loading the previous bundle
	# from local cache with nothing to indicate it was stale.
	#
	# Vite content-hashes everything under /assets, so those filenames change
	# whenever their contents do and can be cached hard and indefinitely.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# index.html is the one file that is NOT hashed - it is what names the
	# current bundle, so a stale copy pins the browser to a bundle the server
	# has already deleted. no-cache does not stop it being stored; it requires
	# revalidation, so an unchanged page still costs only a 304.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# `handle` blocks, not a bare matcher on reverse_proxy: only the first
	# matching block runs, which is what keeps API and SPA routing apart.
	# With a plain `reverse_proxy @api` plus a top-level `try_files`, the
	# try_files runs on EVERY request regardless of the matcher - Caddy
	# executes directives in its own hard-coded order, and try_files sorts
	# ahead of reverse_proxy - so /health was rewritten to /index.html and
	# the API returned the SPA's HTML instead of JSON.
	#
	# Every path here mirrors the frontend's dev proxy
	# (frontend/vite.config.ts), so "works in dev" and "works in prod" mean
	# the same routing.
	handle /health* {
		reverse_proxy backend:8000
	}
	handle /upload-invoice* {
		reverse_proxy backend:8000
	}
	handle /clear-cache* {
		reverse_proxy backend:8000
	}
	handle /invoices* {
		reverse_proxy backend:8000
	}
	# /reports/* with the slash, NOT /reports* — the SPA owns the page route
	# /reports and the API owns /reports/<report>. Routing the bare prefix would
	# hand the page itself to the backend, which answers 404. Mirrors the
	# trailing slash in the frontend's dev proxy for the same reason.
	handle /reports/* {
		reverse_proxy backend:8000
	}

	handle /item-types* {
		reverse_proxy backend:8000
	}

	handle /products* {
		reverse_proxy backend:8000
	}

	# Only the API subpaths: /inventory itself is a page in the SPA, so it
	# must not be forwarded. Same reason /reports uses a trailing slash.
	handle /inventory/* {
		reverse_proxy backend:8000
	}

	# Sign-in and account management. Slash form so /auth stays free as a
	# client-side route, same as /reports.
	handle /auth/* {
		reverse_proxy backend:8000
	}

	# Everything else is the SPA. try_files falls back to index.html so
	# client-side routes like /catalogue or /review/<id> resolve on a hard
	# refresh instead of 404ing - there is no file at that path, only a
	# React Router route the app defines after index.html loads.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
