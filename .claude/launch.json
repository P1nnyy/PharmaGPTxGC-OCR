{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "V=.venv; [ -d \"$V\" ] || V=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.venv\"; exec \"$V/bin/python\" main.py"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 5173
    }
  ]
}
